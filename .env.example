# Contoh konfigurasi PeopleBot. Salin file ini menjadi .env lalu pilih
# nilai Windows atau Linux pada baris yang diberi tanda.

# Konfigurasi serial P3-DX. Aktifkan satu SERIAL_PORT sesuai sistem operasi.
# Linux:
SERIAL_PORT=/dev/ttyS0
# Windows:
# SERIAL_PORT=COM3
SERIAL_BAUDRATE=9600
# true menonaktifkan serial robot dan hanya mencetak perintah dari RabbitMQ.
SERIAL_SIMULATION=true

# RabbitMQ
RABBITMQ_WS_URL=wss://amqp.luminaire.software:443/ws
RABBITMQ_HOST=amqp.luminaire.software
RABBITMQ_PORT=5672
RABBITMQ_QUEUE=control
RABBITMQ_QUEUE_SENSOR=sensor
RABBITMQ_QUEUE_TERMINAL=terminal
RABBITMQ_USER=your_rabbitmq_username
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_VHOST=/

# Sensor
# true memakai data simulasi; false membaca sensor melalui serial.
SENSOR_SIMULATION=true
VERBOSE_SONAR=true

# ARIA paths (opsional; pilih nilai untuk sistem operasi yang dipakai).
# Linux:
ARIA_BIN=/usr/local/Aria/bin
ARIA_PYTHON=/usr/local/Aria/python
# Windows:
# ARIA_BIN="C:\Program Files\MobileRobots\Aria\bin"
# ARIA_PYTHON="C:\Program Files\MobileRobots\Aria\python"

# Setup / virtual environment
VENV_DIR=.venv
# Linux:
WHEELS_DIR=./wheels
PYTHON27_PATH=/usr/bin/python2.7
# Windows alternatives:
# WHEELS_DIR=.\wheels
# PYTHON27_PATH=C:\Python27-32\python.exe
